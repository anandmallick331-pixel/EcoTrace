# ==========================================
# EcoTrace Root Environment Example
# ==========================================

# ── Backend Configuration (backend/.env) ──
ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/s21_db
APP_NAME=EcoTrace
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
LOG_LEVEL=INFO

# ── Frontend Configuration (frontend/.env) ──
VITE_API_URL=/api/v1

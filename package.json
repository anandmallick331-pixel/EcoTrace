{
  "name": "ecotrace-integrated",
  "version": "1.0.0",
  "private": true,
  "description": "EcoTrace - Integrated Ecotourism Impact Ledger & Observability Platform",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "cd backend && python -m pytest tests/",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
